[
  {
    "doc_id": "D01",
    "title": "差旅报销期限",
    "version_date": "2026-01-01",
    "chunks": {
      "p1": "员工应在差旅结束后 30 天内提交报销申请。"
    }
  },
  {
    "doc_id": "D03",
    "title": "差旅报销材料",
    "version_date": "2026-02-01",
    "chunks": {
      "p1": "差旅报销需要提交发票、行程单和出差审批记录。"
    }
  },
  {
    "doc_id": "D04",
    "title": "报销审批流程",
    "version_date": "2026-02-01",
    "chunks": {
      "p1": "报销申请先由直属主管审批，再由财务审核。"
    }
  },
  {
    "doc_id": "D10",
    "title": "国内差旅住宿限额",
    "version_date": "2026-06-01",
    "chunks": {
      "p1": "国内差旅住宿按实际金额报销，每人每晚最高 500 元；超额部分不予报销。"
    }
  },
  {
    "doc_id": "D11",
    "title": "境外差旅住宿限额",
    "version_date": "2026-06-01",
    "chunks": {
      "p1": "境外差旅住宿每人每晚最高 900 元人民币，须附支付凭证与汇率说明。"
    }
  },
  {
    "doc_id": "D12",
    "title": "住宿规则适用范围",
    "version_date": "2026-06-01",
    "chunks": {
      "p1": "D10 仅适用于国内差旅，D11 仅适用于境外差旅。住宿限额按每人每晚计算，不是整次出差总额。"
    }
  },
  {
    "doc_id": "D13",
    "title": "报销提交与到账时间区别",
    "version_date": "2026-06-01",
    "chunks": {
      "p1": "报销提交期限指员工提交申请的期限。财务审核通过后 7 个工作日内付款；付款时间不等于提交期限。"
    }
  },
  {
    "doc_id": "D14",
    "title": "差旅补贴",
    "version_date": "2026-06-01",
    "chunks": {
      "p1": "国内差旅餐饮补贴为每人每天 80 元，无须餐饮发票；住宿报销仍需住宿发票。"
    }
  },
  {
    "doc_id": "D15",
    "title": "发票遗失处理",
    "version_date": "2026-06-01",
    "chunks": {
      "p1": "住宿发票遗失时应向开票方申请补开。现有资料未规定无法补开时是否可报销，需财务确认。"
    }
  },
  {
    "doc_id": "D16",
    "title": "报销审批金额分级",
    "version_date": "2026-06-01",
    "chunks": {
      "p1": "报销金额不超过 5000 元时，直属主管审批后由财务审核；超过 5000 元还需部门负责人批准。"
    }
  },
  {
    "doc_id": "D17",
    "title": "市内通勤费用",
    "version_date": "2026-06-01",
    "chunks": {
      "p1": "日常上下班通勤不属于差旅，不适用差旅交通费报销规则。"
    }
  },
  {
    "doc_id": "D18",
    "title": "差旅交通费用",
    "version_date": "2026-06-01",
    "chunks": {
      "p1": "因公出差的高铁二等座可凭票报销；本条不规定机票舱位或退改签费用。"
    }
  },
  {
    "doc_id": "D19",
    "title": "差旅预借款归还",
    "version_date": "2026-06-01",
    "chunks": {
      "p1": "差旅预借款须在差旅结束后 10 天内结清。预借款结清期限与报销申请提交期限是不同事项。"
    }
  },
  {
    "doc_id": "D02",
    "title": "报销期限通知",
    "version_date": "2026-03-01",
    "chunks": {
      "p1": "员工应在差旅结束后 15 天内提交报销申请。"
    }
  }
]
